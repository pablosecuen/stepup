# TeacherFlow Web — variables de entorno.
# Este archivo sólo documenta NOMBRES de variables futuras — no contiene
# ningún valor real ni secreto. Se completa recién en la fase de conexión
# con Supabase (todavía no autorizada).

# Supabase — infraestructura de autenticación lista, todavía sin conectar
# a ningún proyecto real (ver lib/auth/config.ts: en desarrollo, sin estas dos
# variables o con valores de ejemplo como los de abajo, la web muestra un estado
# controlado de "entorno de autenticación no configurado" y nunca intenta
# conectarse; en PRODUCTION una configuración ausente o inválida deja el área
# privada no disponible (503), nunca abierta). Nunca la service_role key acá ni en
# ningún archivo del repo.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_example_placeholder

# Origen canónico del sitio para los enlaces de los correos de alta y de
# recuperación de contraseña (ver lib/auth/site-origin.ts). En Production es
# OBLIGATORIA: HTTPS y un host permitido (hoy sólo teacherflowapp.com); si falta
# o es inválida, el correo no se envía. En desarrollo es opcional (se usa
# localhost).
NEXT_PUBLIC_SITE_URL=https://teacherflowapp.com

# CAPTCHA (Cloudflare Turnstile) — OPCIONAL y DESACTIVADO si esta variable no está (ver lib/auth/captcha.ts).
# Es la clave de SITIO (pública por diseño). La clave SECRETA no va nunca en este repo ni en Vercel: se carga sólo en el panel de
# Supabase (Authentication > Bot and Abuse Protection). ORDEN: 1) crear el sitio en Turnstile, 2) definir esta variable en Vercel y
# desplegar, 3) RECIÉN DESPUÉS activar CAPTCHA en Supabase. Al revés, todos los inicios de sesión, altas y recuperaciones fallarían.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Secreto para FIRMAR el marcador de recuperación de contraseña (R4, lib/auth/recovery-marker.ts). SECRETO, sólo del servidor: nunca
# NEXT_PUBLIC_*, nunca en el repo. Cadena aleatoria de 32+ caracteres (p. ej. `openssl rand -base64 48`). En PRODUCTION es OBLIGATORIO:
# sin él un enlace de recuperación verificado no puede dejar marcador y la persona ve un error controlado (nunca se acepta uno sin
# firmar). Se define en Vercel (Production). En desarrollo es opcional (se usa un valor local sin valor real).
# ROTACIÓN sin cortar recuperaciones en curso (duran 15 minutos): 1) pasar el valor actual a RECOVERY_MARKER_SECRET_PREVIOUS,
# 2) poner el nuevo en RECOVERY_MARKER_SECRET, 3) desplegar, 4) pasados 15 minutos borrar RECOVERY_MARKER_SECRET_PREVIOUS.
RECOVERY_MARKER_SECRET=
# RECOVERY_MARKER_SECRET_PREVIOUS=

# ---------------------------------------------------------------------------------------------------------------------------------
# FACTURACIÓN / SUSCRIPCIONES (M1) — TODO es SOLO DEL SERVIDOR: ninguna de estas variables lleva jamás el prefijo NEXT_PUBLIC_.
# En M1 NO están configuradas en Vercel y la facturación está APAGADA: Production funciona exactamente como antes.
# Sólo el texto exacto "true" enciende un interruptor; cualquier otro valor (o la ausencia) es APAGADO.
BILLING_ENABLED=false
# Control de acceso por estado de suscripción. Sin BILLING_ENABLED=true no tiene efecto. NO encender antes de la revisión de M2.
BILLING_ENFORCEMENT_ENABLED=false
# Proveedor de cobros (Mobbex). Credenciales de la cuenta SANDBOX primero; nunca se commitean ni se registran.
# MOBBEX_API_KEY=
# MOBBEX_ACCESS_TOKEN=
# MOBBEX_SANDBOX=true
# URL HTTPS de avisos que se escribe en cada suscripción plantilla al crearla (sólo se usa en esa herramienta, no en el receptor).
# MOBBEX_WEBHOOK_URL=
# Suscripción (plantilla) de cada plan en Mobbex: son identificadores, no secretos.
# MOBBEX_SUBSCRIPTION_UID_TF_MONTHLY_ARS_V1=
# MOBBEX_SUBSCRIPTION_UID_TF_QUARTERLY_ARS_V1=
# MOBBEX_SUBSCRIPTION_UID_TF_SEMIANNUAL_ARS_V1=
# MOBBEX_SUBSCRIPTION_UID_TF_ANNUAL_ARS_V1=
# Clave de servicio de Supabase: la usa ÚNICAMENTE lib/billing/supabase-store.ts para llamar a las funciones billing_* (sólo
# ejecutables por service_role). Decisión de Joaquín antes de M2. Nunca en el repo ni con prefijo NEXT_PUBLIC_.
# SUPABASE_SERVICE_ROLE_KEY=

# --- M2 ---
# Adaptador de cobros: `rebill` (vigente y por defecto; sin credenciales o con una configuración que mezcla ambientes queda CERRADO y no sale ningún pedido),
# `mobbex` (sólo explícito, para operaciones históricas) o `fake` (doble de prueba, SOLO fuera de Production: en Production se ignora y se usa Rebill).
# Los estados de demostración de las pantallas sólo existen con `fake` en el servidor de desarrollo local.
BILLING_PROVIDER=rebill
# --- Rebill (docs/billing/REBILL.md). Todo SOLO del servidor. El sandbox y la producción de Rebill son organizaciones distintas: NUNCA se mezclan claves, planes ni avisos. ---
# Clave SECRETA de la organización (empieza con sk_). Una clave pública (pk_) no sirve. Se carga SÓLO en la configuración segura de Vercel.
# REBILL_API_KEY=
# sandbox (organización de prueba: todos los identificadores llevan `test_`) o production (identificadores reales). Si no coincide con los ids de plan, el adaptador se cierra.
# REBILL_ENVIRONMENT=
# Secreto de firma de los avisos (empieza con whsec_), el de la organización del mismo ambiente que la clave.
# REBILL_WEBHOOK_SECRET=
# Plan (pln_…) de Rebill y dirección del pago (https://pay.rebill.com/…) de cada plan vigente del catálogo: son identificadores, no secretos.
# REBILL_PLAN_ID_TF_MONTHLY_ARS_V2=
# REBILL_PLAN_ID_TF_QUARTERLY_ARS_V2=
# REBILL_PLAN_ID_TF_SEMIANNUAL_ARS_V2=
# REBILL_PLAN_ID_TF_ANNUAL_ARS_V2=
# REBILL_CHECKOUT_URL_TF_MONTHLY_ARS_V2=
# REBILL_CHECKOUT_URL_TF_QUARTERLY_ARS_V2=
# REBILL_CHECKOUT_URL_TF_SEMIANNUAL_ARS_V2=
# REBILL_CHECKOUT_URL_TF_ANNUAL_ARS_V2=
# Capacidades de Rebill declaradas VALIDADAS en sandbox por quien opera el sistema (coma): changePlan, paymentMethodUpdate. Vacío = no se ofrecen.
# REBILL_VALIDATED_CAPABILITIES=
# Secreto de los trabajos programados (cron): `Authorization: Bearer <CRON_SECRET>`. 32+ caracteres aleatorios, sólo servidor.
# CRON_SECRET=
# Capacidades de Mobbex declaradas VALIDADAS en sandbox por quien opera el sistema (separadas por coma): changePlan, paymentMethodUpdate.
# Vacío = ninguna: el cambio de plan y el cambio de medio de pago no se ofrecen ni se ejecutan.
# MOBBEX_VALIDATED_CAPABILITIES=
# Sólo con BILLING_ENFORCEMENT_ENABLED=true: corte de cuentas existentes (el mismo instante guardado en billing_settings, ISO) y secreto
# para firmar la última verificación del estado (32+ caracteres).
# BILLING_GRANDFATHER_CUTOFF=
# BILLING_STATE_COOKIE_SECRET=
# Correo de soporte que muestran las pantallas de facturación (lo define TeacherFlow). Sin él no se dibuja ningún enlace de correo.
# BILLING_SUPPORT_EMAIL=
# «true» sólo cuando asesoría legal revisó lib/billing/legal.ts (mientras tanto la página de condiciones muestra el aviso de borrador).
# BILLING_LEGAL_REVIEWED=
