# Con este archivo presente, Vercel CLI deja de usar .gitignore: se replica acá
# todo lo ignorado por git y se suman los artefactos locales que NO son parte
# de la aplicación. No excluye código, public/ ni configuración necesaria para
# el build (app/, components/, lib/, public/, package*.json, *.config.*, tsconfig.json, proxy.ts).

# Salidas y notas locales de trabajo (nunca van a un despliegue)
/Claude outputs/
/.claude/

# Variables de entorno locales: las del despliegue viven en Vercel
.env
.env.*

# Vinculación local con Vercel y caches de build locales
.vercel/
/.next/
/out/
/build/
/coverage/
*.tsbuildinfo
next-env.d.ts

# Dependencias (se instalan en el build)
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# Estado local de la CLI de Supabase (ref del proyecto, versiones, etc.)
/supabase/.temp/

# Varios
.DS_Store
*.pem
npm-debug.log*
yarn-debug.log*
yarn-error.log*
